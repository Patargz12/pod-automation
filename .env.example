# Printify Personal Access Token
# Generate at: Printify Dashboard -> My Profile -> Connections -> Generate
# Required scopes: shops.read, catalog.read, uploads.read, uploads.write,
#                  products.read, products.write
PRINTIFY_API_TOKEN=

# Optional: force a specific shop. Leave blank to auto-detect (first Etsy-connected,
# else first shop). Find the id printed by the script, or via GET /v1/shops.json
PRINTIFY_SHOP_ID=

# Google Gemini API keys — used to AI-generate the SEO title, description and
# tags for each design (Gemini 2.5 Flash looks at the design image).
# Get keys at Google AI Studio: https://aistudio.google.com → Get API key.
# The keys form a rotating pool: when one hits its quota/rate limit, the next
# one takes over automatically. Fill in as many as you have (blanks are skipped);
# if none work, listings fall back to a placeholder.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Gemini model used for ALL generation (listings, descriptions, Pinterest copy).
# Default is gemini-3.6-flash — approved 11 Sept 2026. gemini-2.5-flash no longer
# works for this shop's keys. Leave blank to use the default.
GEMINI_MODEL=

# Etsy App credentials — both from https://www.etsy.com/developers/your-apps
# Used by etsy_auth.py (one-time browser grant) and marketing_sweatshirt.py.
# Since Feb 9 2026 Etsy requires BOTH on every API request
# (x-api-key: keystring:sharedsecret).
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=

# Optional: override the OAuth callback port (default 8080). The URL
# http://localhost:<port>/callback must be registered in the Etsy app settings.
ETSY_AUTH_PORT=

# ── Pinterest ────────────────────────────────────────────────────────────────
# App credentials from https://developers.pinterest.com/apps/ (your app page).
# Used by pinterest_auth.py (one-time browser grant) and sweatshirt_automation.py.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Optional: OAuth callback port (default 8081). Deliberately NOT 8080 — that one
# belongs to Etsy. http://localhost:<port>/callback must be registered EXACTLY
# as a redirect URI in the Pinterest app settings.
PINTEREST_AUTH_PORT=

# Which Pinterest host to talk to: sandbox (default) or production.
# An app on TRIAL access CANNOT create pins in production — keep this on sandbox
# until Standard access is approved. Sandbox pins are visible only to you, and
# sandbox boards are a separate universe from the ones in the Pinterest web UI.
# Switching this requires re-running pinterest_auth.py: tokens are stamped with
# the environment they were granted for.
PINTEREST_ENV=sandbox

# Optional: echo every Pinterest API call as `METHOD url → status`.
# Set this to 1 when screen-recording the demo video for Standard access —
# Pinterest accepts terminal recordings and reviewers want to see real API
# calls. Logs method/URL/status only, never the token or request body.
PINTEREST_VERBOSE=

# Optional: only needed to pin into a board OTHER than the defaults
# "AI Humor" (AI-user jokes) and "Programming Vibes" (developer jokes).
PINTEREST_BOARD_AI_HUMOR=
PINTEREST_BOARD_PROGRAMMING=

# Optional: seconds to wait for Printify→Etsy sync before giving up on a design
# and leaving it for the next run (default 600).
POD_SYNC_TIMEOUT=
